<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.20.0">
  <bpmn:process id="Process_1" name="Reembolso" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Solicitud recibida"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Activity_Revisar" name="Revisar solicitud"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_1" name="¿Monto alto?" default="Flow_No"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_Si</bpmn:outgoing><bpmn:outgoing>Flow_No</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_Aprobar" name="Aprobación gerencial"><bpmn:incoming>Flow_Si</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Activity_Pagar" name="Pagar reembolso"><bpmn:incoming>Flow_No</bpmn:incoming><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="Event_Fin" name="Reembolsado"><bpmn:incoming>Flow_4</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Activity_Revisar"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Revisar" targetRef="Gateway_1"/>
    <bpmn:sequenceFlow id="Flow_Si" name="sí" sourceRef="Gateway_1" targetRef="Activity_Aprobar"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${monto &gt; 1000}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_No" name="no" sourceRef="Gateway_1" targetRef="Activity_Pagar"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_Aprobar" targetRef="Activity_Pagar"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_Pagar" targetRef="Event_Fin"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1"><dc:Bounds x="152" y="192" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Revisar_di" bpmnElement="Activity_Revisar"><dc:Bounds x="240" y="170" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_1_di" bpmnElement="Gateway_1" isMarkerVisible="true"><dc:Bounds x="395" y="185" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Aprobar_di" bpmnElement="Activity_Aprobar"><dc:Bounds x="500" y="60" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Pagar_di" bpmnElement="Activity_Pagar"><dc:Bounds x="660" y="170" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Fin_di" bpmnElement="Event_Fin"><dc:Bounds x="822" y="192" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="188" y="210"/><di:waypoint x="240" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="340" y="210"/><di:waypoint x="395" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Si_di" bpmnElement="Flow_Si"><di:waypoint x="420" y="185"/><di:waypoint x="420" y="100"/><di:waypoint x="500" y="100"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_No_di" bpmnElement="Flow_No"><di:waypoint x="445" y="210"/><di:waypoint x="660" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="600" y="100"/><di:waypoint x="710" y="100"/><di:waypoint x="710" y="170"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="760" y="210"/><di:waypoint x="822" y="210"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
